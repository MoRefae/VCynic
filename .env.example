DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/vcynic?schema=public"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# VCPilot analysis backend -- server-side only, never prefix these with
# NEXT_PUBLIC_ or the API key would be shipped to every visitor's browser.
VCPILOT_API_URL="http://127.0.0.1:8000"
VCPILOT_API_KEY="replace-with-the-same-value-as-VCPILOT_API_KEY-on-the-vcpilot-api-server"

